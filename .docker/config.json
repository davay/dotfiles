{
	"auths": {
		"snoco.azurecr.io": {},
		"snoco2.azurecr.io": {},
		"snocosurvey.azurecr.io": {}
	},
	"credsStore": "desktop",
	"currentContext": "desktop-linux",
	"cliPluginsExtraDirs": [
		"$HOMEBREW_PREFIX/lib/docker/cli-plugins"
	],
	"plugins": {
		"-x-cli-hints": {
			"enabled": "true"
		},
		"ai": {
			"hooks": "build,buildx build,run,compose"
		},
		"compose": {
			"hooks": "logs,compose logs,compose attach,compose up"
		},
		"debug": {
			"hooks": "exec"
		},
		"scout": {
			"hooks": "pull,buildx build"
		}
	},
	"features": {
		"hooks": "true"
	}
}