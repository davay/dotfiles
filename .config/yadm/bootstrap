#!/bin/sh -x
set -e # exit on any error

# because git submodule commands can't operate without a work tree, they must be run from within $HOME
cd "$HOME"

# [C] This run needs root for several steps and — crucially — so does Homebrew's
# internal installer(8) sudo when Ansible installs pkg-based casks. macOS defaults
# to per-TTY sudo tickets (tty_tickets), which Ansible's TTY-less `become` and
# brew's internal sudo can't see. So for the duration of THIS run we enable a
# GLOBAL sudo timestamp via a sudoers drop-in, keep it warm with the loop below,
# and remove it on exit (trap) so daily-use sudo reverts to per-TTY tickets.
SUDOERS_DROPIN=/etc/sudoers.d/yadm-bootstrap
SUDO_KEEPALIVE_PID=""

cleanup() {
  # [C] Remove the drop-in while the keep-alive ticket is still warm (-n never
  # prompts), clear any cached global ticket, then stop the keep-alive loop.
  sudo -n rm -f "$SUDOERS_DROPIN" 2>/dev/null || true
  sudo -k 2>/dev/null || true
  kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

sudo -v # [C] prompt once, up front

# [C] Validate the drop-in in a temp file BEFORE installing it — a malformed file
# in /etc/sudoers.d could lock sudo out entirely.
dropin_tmp=$(mktemp)
printf 'Defaults timestamp_type=global\n' >"$dropin_tmp"
sudo visudo -cf "$dropin_tmp"
sudo install -m 440 -o root -g wheel "$dropin_tmp" "$SUDOERS_DROPIN"
rm -f "$dropin_tmp"
sudo -v # [C] re-validate so a global-scoped ticket record now exists

# Keep the (now global) sudo ticket warm:
# - refreshes cache every 60s
# - self-terminates once this script ($$) exits
while true; do
  sudo -n true
  sleep 60
  kill -0 "$$" 2>/dev/null || exit
done &
SUDO_KEEPALIVE_PID=$!

### Automated Section ###

echo "Init submodules"
yadm submodule update --recursive --init
yes A | softwareupdate --install-rosetta || true # [C] || true: no-op/non-zero once already installed

# Ansible does the heavy lifting: formulae, casks (incl. pkg-casks), MAS apps, the
# fish shell change, system settings (nvram/spctl/locate/hostnames/fonts) and
# osx_defaults. All root steps reuse the global sudo ticket established above.
brew install ansible
ansible-galaxy install -r ~/.config/yadm/requirements.yml
ansible-playbook -vv ~/.config/yadm/mac-install.yml -i ~/.config/yadm/inventory

# Install Nix package manager, mostly for lazy-lsp.nvim
# [C] || true: the installer exits non-zero if Nix is already present (re-run)
yes | curl -L https://nixos.org/nix/install | sh || true

# No longer using conda, now using mise
# conda create -n py311 python=3.11 -c conda-forge pynvim jupyter_client numpy pandas ruff-lsp jupyterthemes altair
mise install

# To get Altstore AltJit working
# sudo /Applications/Xcode.app/Contents/Developer/usr/bin/python3 -m pip install construct==2.10.69 qh3==0.15.1

### Manual Section ###
# [C] Tear down the global sudo ticket + keep-alive now: nothing below needs root,
# and gh auth login can block for a while — no reason to hold a root ticket open.
cleanup
trap - EXIT INT TERM

# Backblaze (opens the GUI installer - needs manual click-through)
backblaze_path="/opt/homebrew/Caskroom/backblaze"
backblaze_version=$(\ls $backblaze_path | sort -V | tail -n 1) # escape alias-ed ls
open "$backblaze_path/$backblaze_version/Backblaze Installer.app"

# gh auth login (interactive browser/device flow)
gh auth login

cat <<EOF
-----------------------------------
END OF INSTALLATION, PLEASE RESTART
-----------------------------------
EOF
