#!/bin/sh
set -e # exit on any error

# because git submodule commands can't operate without a work tree, they must be run from within $HOME
cd "$HOME"

# [C] Ensure our scripts (dbanner, etc.) are found even on a fresh machine mid-bootstrap
PATH="$HOME/.config/yadm/path-scripts:$PATH"

# [C] Temporary passwordless sudo for the whole bootstrap run, removed on exit.
#
# Why: Homebrew's cask installer and Ansible's `become` both invoke sudo
# non-interactively (no TTY). macOS uses per-TTY sudo tickets, so neither can reuse
# a ticket we cache here -> "sudo: a password is required". We first tried a
# `Defaults timestamp_type=global` drop-in + keep-alive so one cached ticket would
# cover both; it silently had no effect on Ansible's become. A NOPASSWD rule is
# unconditional (no ticket/TTY involved) and just works.
SUDOERS_DROPIN=/etc/sudoers.d/yadm-bootstrap
cleanup() { sudo rm -f "$SUDOERS_DROPIN" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

printf '\a' # bell — the password prompt needs your attention
dbanner red "ENTER SUDO PASSWORD to create a temporary sudoers dropin for noninteractivity"

sudo -v # prompt once for this whole thing

# [C] Validate in a temp file before installing — a malformed drop-in could lock sudo out.
tmp_dropin=$(mktemp)
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$USER" >"$tmp_dropin"
sudo visudo -cf "$tmp_dropin"
sudo install -m 440 -o root -g wheel "$tmp_dropin" "$SUDOERS_DROPIN"
rm -f "$tmp_dropin"
dsay "Sudoers drop-in created in $SUDOERS_DROPIN"

### Automated Section ###

dbanner yellow "YADM"
dsay "Initializing submodules (nested git repos in these dotfiles)" # ... technically a risk?
yadm submodule update --recursive --init

dbanner yellow "ROSETTA"
# [C] arch -x86_64 /usr/bin/true returns 1 (Bad CPU type) unless Rosetta is installed
if [ "$(uname -m)" != arm64 ]; then
  dsay "Intel Mac; Rosetta not needed."
elif arch -x86_64 /usr/bin/true 2>/dev/null; then
  dsay "Rosetta already installed; skipping."
else
  softwareupdate --install-rosetta --agree-to-license || true
fi

dbanner yellow "ANSIBLE"

if command -v ansible >/dev/null 2>&1; then
  dsay "Ansible already installed."
else
  NONINTERACTIVE=1 brew install ansible
fi

ansible-galaxy install -r ~/.config/yadm/requirements.yml
ansible-playbook -vv ~/.config/yadm/mac-install.yml -i ~/.config/yadm/inventory

dbanner yellow "NIX"
# nix is the package backend for lazy-lsp.nvim: it runs language servers straight from
# nixpkgs on demand, so you get hundreds of LSPs without installing each one manually / without needing to maintain a list
yes | curl -L https://nixos.org/nix/install | sh || true # [C] || true: non-zero if already present

dbanner yellow "MISE"
# no longer using conda, now using mise to manage global python env/installations
# conda create -n py311 python=3.11 -c conda-forge pynvim jupyter_client numpy pandas ruff-lsp jupyterthemes altair
mise install

# To get Altstore AltJit working -- 2026-09-23: this is old, maybe it's fixed now?
# sudo /Applications/Xcode.app/Contents/Developer/usr/bin/python3 -m pip install construct==2.10.69 qh3==0.15.1

cleanup # there's already a trap for cleanup, but this cleans earlier as soon as it's not needed -- not technically needed to proceed
dsay "Sudoers drop-in removed."

### Manual Section ###
dbanner yellow "MANUAL"

# Backblaze (opens the GUI installer - needs manual click-through)
backblaze_path="/opt/homebrew/Caskroom/backblaze"
backblaze_version=$(\ls $backblaze_path | sort -V | tail -n 1) # escape alias-ed ls
open "$backblaze_path/$backblaze_version/Backblaze Installer.app"

gh auth login # interactive browser/device flow

dbanner green "END OF INSTALLATION, please restart"
